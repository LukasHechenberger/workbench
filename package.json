{
  "name": "workbench",
  "version": "0.0.0",
  "private": true,
  "description": "Personal helper packages for CI, testing and tooling",
  "license": "MIT",
  "author": "Lukas Hechenberger",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "turbo run //#typecheck //#lint //#format:check",
    "ci": "turbo run test test:integration //#typecheck //#lint //#format:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --max-warnings 0",
    "release": "changeset publish",
    "test": "turbo run test test:integration",
    "typecheck": "tsc --noEmit",
    "version": "changeset version && bun install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^2.29.7",
    "@types/bun": "^1.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3"
    }
  }
}
