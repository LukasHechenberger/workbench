{
  "name": "workbench",
  "version": "0.0.0",
  "private": true,
  "description": "Personal helper packages for CI, testing and tooling",
  "license": "MIT",
  "author": "Lukas Hechenberger",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "changeset": "changeset",
    "check": "tsc --noEmit && oxlint --max-warnings 0 && oxfmt --check",
    "format": "oxfmt",
    "lint": "oxlint --max-warnings 0",
    "release": "changeset publish",
    "test": "bun test",
    "version": "changeset version && bun install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/bun": "^1.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2"
  }
}
