{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "inputs": ["src/**", "package.json", "tsconfig*.json", "$TURBO_ROOT$/scripts/build.ts"],
      "outputs": ["dist/**"]
    },
    "test": {},
    "test:integration": {
      "dependsOn": ["build"],
      "cache": false
    },
    "//#typecheck": {
      "inputs": ["packages/**", "scripts/**", "*.json", "!**/dist/**", "!**/node_modules/**"]
    },
    "//#lint": {
      "inputs": [
        "packages/**",
        "scripts/**",
        "*.json",
        "!**/dist/**",
        "!**/node_modules/**",
        ".oxlintrc.json"
      ]
    },
    "//#format:check": {
      "inputs": [
        "packages/**",
        "scripts/**",
        "*.json",
        "!**/dist/**",
        "!**/node_modules/**",
        ".oxfmtrc.json",
        "**/*.md"
      ]
    }
  }
}
