{
  "name": "@lhechenberger/check-links",
  "version": "0.4.1",
  "description": "Crawls a deployed site for broken links, separating flaky failures from real ones. Built for Vercel preview deployments.",
  "keywords": [
    "broken-links",
    "ci",
    "link-checker",
    "linkinator",
    "vercel"
  ],
  "homepage": "https://github.com/LukasHechenberger/workbench/tree/main/packages/check-links#readme",
  "bugs": {
    "url": "https://github.com/LukasHechenberger/workbench/issues"
  },
  "license": "MIT",
  "author": "Lukas Hechenberger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LukasHechenberger/workbench.git",
    "directory": "packages/check-links"
  },
  "bin": {
    "check-links": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run ../../scripts/build.ts",
    "prepack": "bun run build",
    "test": "bun test src",
    "test:integration": "bun test integration"
  },
  "dependencies": {
    "linkinator": "^8.1.0"
  },
  "engines": {
    "bun": ">=1.2",
    "node": ">=22.18"
  }
}
